# ─────────────────────────────────────────────────────────────────────────────
# GradEdge Environment Variables Example
# ─────────────────────────────────────────────────────────────────────────────

# Master mock services control flag
# When true, services with missing API keys log mock calls with [MOCK <Service>]
# When false, missing required keys fail loudly at startup. Stubs never run in production.
MOCK_SERVICES=true

# Supabase Configuration
# Required for PostgreSQL database, Supabase Auth, Row Level Security (RLS)
# Obtain from: https://supabase.com/dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Google OAuth (configured in Supabase Auth Provider)
# Obtain from: https://console.cloud.google.com/ -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret

# Paystack Payment Gateway
# Required for student checkouts, memberships, and payment verification
# Obtain from: https://dashboard.paystack.com/#/settings/developer
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_WEBHOOK_SECRET=whsec_...

# Resend Transactional Email
# Required for verification emails, booking calendar invites, welcome messages
# Obtain from: https://resend.com/api-keys
RESEND_API_KEY=re_...

# Initial Admin Bootstrap
# Used by one-time script: npm run create-admin
INITIAL_ADMIN_EMAIL=admin@gradedge.com

# Application Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3005
ADMIN_NOTIFICATION_EMAIL=admin@gradedge.com

# Cron Jobs Authorization Secret
# Protects scheduled background routes (/api/cron/*) against unauthorized triggers
CRON_SECRET=your-random-cron-secret-32-chars

# Privacy-Friendly Analytics (Optional)
# If provided, loads lightweight Plausible analytics (no cookies, GDPR-compliant)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=gradedge.org

# Sentry Error Monitoring (Optional)
# Client and server error tracking in production
NEXT_PUBLIC_SENTRY_DSN=https://your-key@o000000.ingest.sentry.io/0000000
SENTRY_AUTH_TOKEN=sntrys_...
